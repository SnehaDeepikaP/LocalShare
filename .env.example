# LocalShare Environment Configuration Template
# Copy this file to .env and replace placeholder values before running.

# Flask Environment: 'development', 'testing', or 'production'
FLASK_CONFIG=production
FLASK_DEBUG=false

# Secret Key: Generate a 64-character random hex string using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-your-cryptographically-secure-random-secret-key-in-production

# Database URL:
# For SQLite: sqlite:///localshare.db
# For PostgreSQL: postgresql://username:password@localhost:5432/localsharedb
DATABASE_URL=sqlite:///localshare.db

# Host and Port settings
HOST=0.0.0.0
PORT=5000

# Security and Rate Limiting
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Google OpenID Connect (OIDC) OAuth Configuration
# 1. Create a project at https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs:
#    - For local development:
#        http://localhost:5000/google/callback
#        http://127.0.0.1:5000/google/callback
#    - For production:
#        https://yourdomain.com/google/callback
# 5. Paste the Client ID and Secret below:
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

